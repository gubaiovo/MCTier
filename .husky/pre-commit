# 运行 lint-staged 检查暂存的文件
npx lint-staged || exit 1

if ! command -v cargo >/dev/null 2>&1; then
  echo "cargo is required for the Rust pre-commit checks" >&2
  exit 1
fi

# 运行 Rust 格式化检查
cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check || exit 1

# 运行 Rust clippy 检查
cargo clippy --manifest-path src-tauri/Cargo.toml --lib --tests -- -D warnings
